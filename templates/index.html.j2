<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ basics.name }} | {{ basics.title }}</title>
  <meta name="description" content="{{ basics.tagline }}">
  <meta property="og:title" content="{{ basics.name }} | {{ basics.title }}">
  <meta property="og:description" content="{{ basics.tagline }}">
  <meta property="og:type" content="profile">
  <meta property="og:url" content="{{ site_url }}">
  <link rel="canonical" href="{{ site_url }}">
  <script type="application/ld+json">{{ person_jsonld | safe }}</script>
  <link rel="stylesheet" href="style.css">
</head>
<body>
  <main>
    <header class="hero">
      <h1>{{ basics.name }}</h1>
      <p class="title">{{ basics.title }}</p>
      <p class="stack">{{ basics.headline }}</p>
      <nav class="links">
        {% for link in basics.links %}<a href="{{ link.url }}">{{ link.label }}</a>{% endfor %}
        <a href="mailto:{{ basics.email }}">Email</a>
        <a href="resume.pdf" class="primary">Resume (PDF)</a>
      </nav>
    </header>

    <section>
      <h2>Summary</h2>
      <p>{{ basics.summary }}</p>
    </section>

    <section>
      <h2>Experience</h2>
      {% for job in experience %}
      <div class="company">
        <div class="company-head">
          <h3>{{ job.company }}</h3>
          <span class="meta">{{ job.location }}</span>
        </div>
        {% for role in job.roles %}
        <div class="role">
          <div class="role-head">
            <strong>{{ role.title }}</strong>
            <span class="meta">{{ role.period }}</span>
          </div>
          {% if role.context %}<p class="context">{{ role.context }}</p>{% endif %}
          <ul>{% for h in role.highlights %}<li>{{ h }}</li>{% endfor %}</ul>
        </div>
        {% endfor %}
      </div>
      {% endfor %}
    </section>

    <section>
      <h2>Education</h2>
      {% for e in education %}
      <div class="row"><span><strong>{{ e.degree }}</strong><br><span class="muted">{{ e.institution }}</span></span><span class="meta">{{ e.period }}</span></div>
      {% endfor %}
    </section>

    <section>
      <h2>Skills</h2>
      {% for s in skills %}
      <p class="skill"><strong>{{ s.group }}:</strong> {{ s["items"] | join(", ") }}</p>
      {% endfor %}
    </section>

    <section>
      <h2>Side projects</h2>
      <div class="projects">
        {% for p in projects %}
        <article class="project">
          <h3>{% if p.url %}<a href="{{ p.url }}">{{ p.name }}</a>{% else %}{{ p.name }} <span class="meta">(private repo)</span>{% endif %}</h3>
          <p>{{ p.description }}</p>
          <ul class="tags">{% for t in p.stack %}<li>{{ t }}</li>{% endfor %}</ul>
        </article>
        {% endfor %}
      </div>
    </section>

    <section>
      <h2>Publications</h2>
      <ul class="plain">{% for pub in publications %}<li>{{ pub }}</li>{% endfor %}</ul>
    </section>

    <section class="two-col">
      <div>
        <h2>Certifications</h2>
        <ul class="plain">{% for c in certifications %}<li>{{ c }}</li>{% endfor %}</ul>
      </div>
      <div>
        <h2>Languages</h2>
        <ul class="plain">{% for l in languages %}<li><strong>{{ l.name }}</strong>: {{ l.level }}</li>{% endfor %}</ul>
      </div>
    </section>

    <footer>
      <p>{{ basics.location }} &middot; Updated {{ build_date }}</p>
    </footer>
  </main>
</body>
</html>
