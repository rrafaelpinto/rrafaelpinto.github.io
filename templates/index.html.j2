<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ basics.name }} | {{ basics.title }}</title>
  <meta name="description" content="{{ basics.tagline }}">
  <meta property="og:title" content="{{ basics.name }} | {{ basics.title }}">
  <meta property="og:description" content="{{ basics.tagline }}">
  <meta property="og:type" content="profile">
  <meta property="og:url" content="{{ site_url }}">
  <link rel="canonical" href="{{ site_url }}">
  <script type="application/ld+json">{{ person_jsonld | safe }}</script>
  <link rel="stylesheet" href="style.css">
</head>
<body>
  <main>
    <header class="hero">
      <h1>{{ basics.name }}</h1>
      <p class="title">{{ basics.title }}</p>
      <p class="stack">{{ basics.headline }}</p>
      <div class="links hero-actions">
        <a href="resume.pdf" class="primary">Resume (PDF)</a>
        <a href="#projects" class="secondary">View projects</a>
        <a href="#experience">Experience</a>
      </div>
      <nav class="links contact-links" aria-label="Contact and profiles">
        {% for link in basics.links %}<a href="{{ link.url }}">{{ link.label }}</a>{% endfor %}
        <a href="mailto:{{ basics.email }}">Email</a>
        <a href="{{ basics.booking.url }}" target="_blank" rel="noopener">{{ basics.booking.label }}</a>
      </nav>
    </header>

    <section class="summary">
      <h2>Summary</h2>
      {% for paragraph in basics.summary.split(" I have led", 1) %}
      {% set text = paragraph if loop.first else "I have led" ~ paragraph %}
      {% set before, result, after = text.partition("from about 3.5 s to under 500 ms") %}
      <p>{{ before }}{% if result %}<strong>{{ result }}</strong>{{ after }}{% endif %}</p>
      {% endfor %}
    </section>

    <section id="experience">
      <h2>Experience</h2>
      {% for job in experience %}
      <div class="company">
        <div class="company-head">
          <h3>{{ job.company }}</h3>
          <span class="meta">{{ job.location }}</span>
        </div>
        {% for role in job.roles %}
        <div class="role">
          <div class="role-head">
            <strong>{{ role.title }}</strong>
            <span class="meta">{{ role.period }}</span>
          </div>
          {% if role.context %}<p class="context">{{ role.context }}</p>{% endif %}
          <ul>{% for h in role.highlights %}<li>{{ h }}</li>{% endfor %}</ul>
        </div>
        {% endfor %}
      </div>
      {% endfor %}
      <p class="earlier">{{ earlier_experience }}</p>
    </section>

    <section id="projects">
      <h2>Projects</h2>
      <div class="projects">
        {% for f in featured %}
        <article class="project">
          <h3>{{ f.name }}</h3>
          <p class="project-label">{{ f.label }}</p>
          <p class="project-meta">{{ f.status }} &middot; Since {{ f.started }}</p>
          <ul class="project-links">
            {% for l in f.links %}
            <li><a href="{{ l.url }}">{{ {"View Product": "Product website", "Engineering Overview": "Engineering overview"}.get(l.label, l.label) }}</a></li>
            {% endfor %}
          </ul>
          <p class="project-tagline">{{ f.tagline }}</p>
          <p>{{ f.description }}</p>
          <ul class="tags">{% for t in f.stack %}<li>{{ t }}</li>{% endfor %}</ul>
          {% if f.highlights %}
          <details class="project-details">
            <summary>Technical highlights</summary>
            <ul>{% for h in f.highlights %}<li>{{ h }}</li>{% endfor %}</ul>
          </details>
          {% endif %}
        </article>
        {% endfor %}
        {% for p in projects %}
        <article class="project">
          <h3>{{ p.name }}</h3>
          {% if p.url %}
          <ul class="project-links"><li><a href="{{ p.url }}" aria-label="{{ p.name }} on GitHub">View on GitHub</a></li></ul>
          {% else %}
          <p class="project-meta">Private repository</p>
          {% endif %}
          <p>{{ p.description }}</p>
          <ul class="tags">{% for t in p.stack %}<li>{{ t }}</li>{% endfor %}</ul>
        </article>
        {% endfor %}
      </div>
    </section>

    <section>
      <h2>Skills</h2>
      {% for s in skills %}
      <p class="skill"><strong>{{ s.group }}:</strong> {{ s["items"] | join(", ") }}</p>
      {% endfor %}
    </section>

    <section>
      <h2>Education</h2>
      {% for e in education %}
      <div class="row"><span><strong>{{ e.degree }}</strong><br><span class="muted">{{ e.institution }}</span></span><span class="meta">{{ e.period }}</span></div>
      {% endfor %}
    </section>

    <section class="two-col">
      <div>
        <h2>Certifications</h2>
        <ul class="plain">{% for c in certifications %}<li>{{ c }}</li>{% endfor %}</ul>
      </div>
      <div>
        <h2>Languages</h2>
        <ul class="plain">{% for l in languages %}<li><strong>{{ l.name }}</strong>: {{ l.level }}</li>{% endfor %}</ul>
      </div>
    </section>

    <footer>
      <p>{{ basics.location }} &middot; Updated {{ build_date }}</p>
    </footer>
  </main>
</body>
</html>
